# Environment
ENVIRONMENT=development

# API
API_VERSION=0.1.0
API_TITLE=Docuify API
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=10
RATE_LIMIT_SECONDS=60

# Database
DATABASE_URL=postgresql+asyncpg://docuify:docuify@localhost:5432/docuify
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis (for rate limiting and jobs)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=50
MAX_DOWNLOAD_MB=100
DOWNLOAD_TIMEOUT_SECS=60
ALLOWED_URL_SCHEMES=http,https

# LLM Provider
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# RAG Configuration
RAG_BACKEND=qdrant
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Qdrant (if using)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Workers (Celery/RQ)
WORKER_BROKER_URL=redis://localhost:6379/1
WORKER_RESULT_BACKEND=redis://localhost:6379/2
