# Environment
ENVIRONMENT=development

# API
API_PREFIX=/api/v1

# Security (use a long random value outside local development)
SECRET_KEY=change-me-change-me-change-me-change-me
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Rate limiting (needs Redis when enabled)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_TIMES=10
RATE_LIMIT_SECONDS=60
REDIS_URL=redis://localhost:6379/0

# Database: SQLite for a quick try, PostgreSQL for real use
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://folio:folio@localhost:5432/folio

# Storage and limits
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAX_DOWNLOAD_MB=100
DOWNLOAD_TIMEOUT_SECS=60
ALLOWED_URL_SCHEMES=http,https

# Retrieval
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RAG_TOP_K=5

# Embeddings: "none" = keyword retrieval only, "fastembed" = local ONNX model
# (install with: pip install ".[embeddings]")
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Answers: "extractive" needs no model and no key.
# "anthropic" / "openai" need LLM_API_KEY; "ollama" needs LLM_BASE_URL (e.g. http://localhost:11434/v1).
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Let a request bring its own key (X-LLM-Provider / X-LLM-Key headers)
ALLOW_CLIENT_LLM_KEYS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
