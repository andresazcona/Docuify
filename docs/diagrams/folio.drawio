<mxfile host="app.diagrams.net"><diagram name="Architecture" id="architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;&quot;&gt;Folio: architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666;&quot;&gt;React · nginx · FastAPI · PostgreSQL · local embeddings · optional LLM&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="450.0" y="14" width="800" height="46" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;React SPA · ES / EN&lt;br&gt;answers stream in as SSE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;static files + /api proxy&lt;br&gt;buffering off for SSE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="API container (FastAPI, non-root)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;opacity=45;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="700" height="600" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Documents API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;upload · arXiv · URL (SSRF guard)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="180" width="250" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Chat API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;ask · history · streamed answers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;RAG pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;extract pages&lt;br&gt;↓&lt;br&gt;chunk (600 / 100)&lt;br&gt;↓&lt;br&gt;BM25 + cosine, fused (RRF)&lt;br&gt;↓&lt;br&gt;extractive answer (default)&lt;br&gt;or LLM answer with [n] citations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="180" width="290" height="230" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;fastembed (ONNX)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;multilingual MiniLM&lt;br&gt;CPU only, no key&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="520" width="250" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;LLM client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;Anthropic · OpenAI · Ollama&lt;br&gt;endpoint fixed by operator&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="520" width="290" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;documents · chunks (+ vectors)&lt;br&gt;chats · messages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1380" y="160" width="250" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;PDF storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;volume · type and magic bytes checked&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1380" y="320" width="250" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Anthropic API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="480" width="250" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;OpenAI API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="560" width="250" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ollama (local)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;LLM_BASE_URL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="640" width="250" height="60" as="geometry"/></mxCell><mxCell id="c16" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#D79B00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#D79B00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="vectors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#82B366;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#B85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="PDF files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#B85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;• Clients may bring an API key (X-LLM-Key) but never choose the endpoint: no SSRF&lt;br&gt;• Keys live in memory for one request: never logged, never stored&lt;br&gt;• URL ingestion blocks private and loopback addresses&lt;br&gt;• Containers run as non-root; the database is not published" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="500" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Why no vector database&lt;/b&gt;&lt;br&gt;Retrieval is per document (a few thousand chunks), so scoring in process is fast and removes a service. pgvector is the next step if documents grow." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="500" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Cost to run:&lt;/b&gt; $0. Default mode needs no model, no API key and no cloud." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="770" width="700" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Question flow" id="question-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px;&quot;&gt;From PDF to cited answer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666;&quot;&gt;ingestion on upload, retrieval and answering on every question&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="450.0" y="14" width="800" height="46" as="geometry"/></mxCell><mxCell id="c3" value="1. Ingestion (once per document)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;opacity=45;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1640" height="230" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. Upload PDF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;file, arXiv or URL&lt;br&gt;validated: type, size, SSRF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="270" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2. Extract text&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;pypdf, page by page&lt;br&gt;scanned PDFs rejected&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="270" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3. Chunk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;~600 chars, 100 overlap&lt;br&gt;never across pages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="270" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4. Embed (optional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;fastembed, local&lt;br&gt;float32 vectors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="150" width="270" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5. Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;chunks + page + vector&lt;br&gt;document → READY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1340" y="150" width="270" height="100" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#6C8EBF;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="2. Question (every message)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;opacity=45;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="1640" height="380" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;1. Ask&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;POST /chats/chat/stream&lt;br&gt;optional X-LLM-* headers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="270" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;2. Retrieve&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;BM25 over chunk text&lt;br&gt;+ cosine over vectors&lt;br&gt;fused with RRF → top 5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="270" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;3. Answer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;extractive: best sentences&lt;br&gt;LLM: streamed, [n] cited&lt;br&gt;nothing found → says so&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="270" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;4. Stream&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;SSE events:&lt;br&gt;meta (citations) · delta … · done&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="410" width="270" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;5. Show&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;[n] chips link to the&lt;br&gt;source passage and page&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1340" y="410" width="270" height="110" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#D79B00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#D79B00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#D79B00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontColor=#D79B00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Choosing the answer engine&lt;/b&gt;&lt;br&gt;1) a key sent by the client (anthropic / openai), 2) the operator's LLM_PROVIDER (including Ollama), 3) extractive, which needs nothing." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="780" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;When retrieval finds nothing&lt;/b&gt;&lt;br&gt;The LLM is not called at all (no cost, no hallucination): the reply is “I could not find that in the document.” in the language of the question." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="570" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>